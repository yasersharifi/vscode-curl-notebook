@baseUrl = https://httpbin.org
@accept = application/json

###

/*markdown
# Curl Notebook sample

Run cells with the play button. Variables use `{{name}}` syntax.
*/

###

// GET request
# @name healthCheck
curl -sS '{{baseUrl}}/get' \
  -H 'accept: {{accept}}'

###

// POST with JSON body (reuses args from healthCheck URL host)
curl -sS -X POST '{{baseUrl}}/post' \
  -H 'Content-Type: application/json' \
  -d '{"hello": "vscode-curl-notebook", "origin": "{{healthCheck.response.body.origin}}"}'
